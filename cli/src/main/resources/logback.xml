<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress Spoon's internal WARN/INFO messages (e.g. shadow class failures) in normal mode.
         BaseCommand resets this logger to WARN when verbose/debug is enabled. -->
    <logger name="spoon" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
