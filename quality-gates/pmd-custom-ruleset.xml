<ruleset name="JHarmonizer: Custom Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0">
    <description>Everything except LawOfDemeter</description>

    <rule ref="category/java/bestpractices.xml">
        <!-- An exhaustive switch that also has a defensive default throw is a valid safety net
             for when new enum values are added later.  The PMD rule would force removal of the
             default, which would cause new enum values to silently do nothing. -->
        <exclude name="ExhaustiveSwitchHasDefault"/>
    </rule>
    <!-- TODO It's too strict to use and should be reconsidered
    <ruleset>category/java/codestyle.xml</ruleset>
    -->
    <rule ref="category/java/design.xml">
        <exclude name="LawOfDemeter"/>
    </rule>
    <rule ref="category/java/design.xml/LoosePackageCoupling">
        <properties>
            <property name="packages" value="io.github.lemon_ant.jharmonizer"/>
        </properties>
    </rule>
    <!-- TODO Activate it
    ruleset>category/java/documentation.xml</ruleset>
    -->
    <rule ref="category/java/errorprone.xml">
        <!--
            PMD 7 paradox: UnnecessaryWarningSuppression fires for every @SuppressWarnings("PMD.X")
            that successfully suppresses a real violation, because PMD re-evaluates the scope after
            suppression and no longer sees the violation — making the suppression look unnecessary.
            Excluding this rule avoids the false-positive cycle while keeping all other suppressions
            functional. Remove this exclusion if a future PMD release fixes the paradox.
        -->
        <exclude name="UnnecessaryWarningSuppression"/>
    </rule>
    <rule ref="category/java/multithreading.xml"/>
    <rule ref="category/java/performance.xml"/>
    <rule ref="category/java/security.xml"/>
</ruleset>
