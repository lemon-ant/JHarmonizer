<ruleset name="JHarmonizer: Custom Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0">
    <description>Everything except LawOfDemeter</description>

    <rule ref="category/java/bestpractices.xml">
        <!--
            UnnecessaryWarningSuppression fires for every @SuppressWarnings("PMD.X") annotation
            that successfully suppresses a violation, because PMD 7 evaluates suppressions before
            running this rule and therefore sees no live violation at the annotated site.
            The rule cannot coexist with @SuppressWarnings-based suppressions in PMD 7.
        -->
        <exclude name="UnnecessaryWarningSuppression"/>
    </rule>
    <!-- TODO It's too strict to use and should be reconsidered
    <ruleset>category/java/codestyle.xml</ruleset>
    -->
    <rule ref="category/java/design.xml">
        <exclude name="LawOfDemeter"/>
    </rule>
    <rule ref="category/java/design.xml/LoosePackageCoupling">
        <properties>
            <property name="packages" value="io.github.lemon_ant.jharmonizer"/>
        </properties>
    </rule>
    <!-- TODO Activate it
    ruleset>category/java/documentation.xml</ruleset>
    -->
    <rule ref="category/java/errorprone.xml"/>
    <rule ref="category/java/multithreading.xml"/>
    <rule ref="category/java/performance.xml"/>
    <rule ref="category/java/security.xml"/>
</ruleset>
