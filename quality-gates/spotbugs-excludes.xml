<FindBugsFilter>
    <Match>
        <!-- Autogenerated maven-plugin class -->
        <Class name="io.github.lemon_ant.jharmonizer.jharmonizer_maven_plugin.HelpMojo" />
    </Match>
    <Match>
        <!-- Lombok @NonNull generates a null-check in the constructor body; the check is intentional
             and the class is not finalizable, so the CT_CONSTRUCTOR_THROW risk does not apply. -->
        <Class name="io.github.lemon_ant.jharmonizer.cli.command.BaseCommand" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>
</FindBugsFilter>
